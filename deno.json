{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write=logs src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write=logs src/main.ts",
    "test": "deno test -A tests/",
    "check": "deno check src/main.ts scripts/ tests/",
    "token": "deno run --allow-read --allow-write=mirc scripts/token.ts",
    "log:tail": "deno run --allow-read=logs scripts/log_tail.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@^1.32.1/server/mcp.js",
    "@modelcontextprotocol/sdk/server/webStandardStreamableHttp.js": "npm:@modelcontextprotocol/sdk@^1.32.1/server/webStandardStreamableHttp.js",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@^1.32.1/client/index.js",
    "@modelcontextprotocol/sdk/client/streamableHttp.js": "npm:@modelcontextprotocol/sdk@^1.32.1/client/streamableHttp.js",
    "zod": "npm:zod@^4.6.7"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["logs/", "docs/discussion/", ".commandcode/"]
  },
  "compilerOptions": {
    "strict": true
  },
  "exclude": ["logs/", ".commandcode/"]
}
